<Window x:Class="AI_Demo.Views.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AI_Demo.Views"
        mc:Ignorable="d"
        Title="ProductWindow" Height="450" Width="800">
    <StackPanel Margin="20">
        <TextBlock Text="Название"/>
        <TextBox x:Name="txtName" Margin="0,0,0,10"/>

        <TextBlock Text="Цена"/>
        <TextBox x:Name="txtCost" Margin="0,0,0,10"/>

        <TextBlock Text="Производитель"/>
        <ComboBox x:Name="cmbManuf" Margin="0,0,0,10"/>

        <TextBlock Text="Категория"/>
        <ComboBox x:Name="cmbCategory" Margin="0,0,0,10"/>

        <Button Content="Сохранить" Click="BtnSave_Click" Height="30" Margin="0,10"/>
    </StackPanel>
</Window>
