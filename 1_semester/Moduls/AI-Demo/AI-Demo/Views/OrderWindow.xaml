<Window x:Class="AI_Demo.Views.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AI_Demo.Views"
        mc:Ignorable="d"
        Title="OrderWindow" Height="450" Width="800">
    <StackPanel Margin="20">
        <TextBlock Text="Код заказа (Авто)" Foreground="Gray"/>
        <TextBox x:Name="txtId" IsReadOnly="True" Background="#EEE" Margin="0,0,0,10"/>

        <TextBlock Text="Статус заказа"/>
        <ComboBox x:Name="cmbStatus" Margin="0,0,0,10"/>

        <TextBlock Text="Пункт выдачи"/>
        <ComboBox x:Name="cmbPickupPoint" Margin="0,0,0,10"/>

        <TextBlock Text="Дата заказа"/>
        <DatePicker x:Name="dpDate" Margin="0,0,0,10"/>

        <TextBlock Text="Дата доставки"/>
        <DatePicker x:Name="dpDelivery" Margin="0,0,0,10"/>

        <Button Content="Сохранить" Click="BtnSave_Click" Height="30" Margin="0,10"/>
    </StackPanel>
</Window>
