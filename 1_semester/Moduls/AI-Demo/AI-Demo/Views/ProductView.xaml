<Window x:Class="AI_Demo.Views.ProductView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AI_Demo.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Список продуктов" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="10">
            <TextBox x:Name="txtSearch" Width="200" Margin="5" TextChanged="TxtSearch_TextChanged" ToolTip="Поиск по названию"/>
            <ComboBox x:Name="cmbSort" Width="150" Margin="5" SelectionChanged="CmbSort_SelectionChanged">
                <ComboBoxItem Content="Без сортировки"/>
                <ComboBoxItem Content="Цена: по возрастанию"/>
                <ComboBoxItem Content="Цена: по убыванию"/>
            </ComboBox>
            <ComboBox x:Name="cmbFilter" Width="150" Margin="5" SelectionChanged="CmbFilter_SelectionChanged"/>
        </WrapPanel>

        <StackPanel Grid.Row="0" HorizontalAlignment="Right" Orientation="Horizontal" Margin="10">
            <TextBlock x:Name="txtUserName" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button x:Name="btnOrders" Content="Заказы" Click="BtnOrders_Click" Visibility="Collapsed" Margin="5"/>
            <Button x:Name="btnAddProduct" Content="Добавить товар" Click="BtnAddProduct_Click" Visibility="Collapsed" Margin="5"/>
        </StackPanel>

        <ListView x:Name="LvProducts" Grid.Row="1" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="LvProducts_MouseDoubleClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="1" BorderBrush="Gray" CornerRadius="5" Padding="5" Margin="5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CountOnStorage}" Value="0">
                                        <Setter Property="Background" Value="LightGray"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0" Source="{Binding Photo, TargetNullValue=/Images/picture.png}" Height="80" Width="80" Stretch="Uniform"/>
                            
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="{Binding FkProductNameNavigation.Name}" FontWeight="Bold" FontSize="16"/>

                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxHeight="40"/>

                                <TextBlock Text="{Binding FkManufacturerNavigation.Name, StringFormat='Производитель: {0}'}"/>

                                <TextBlock Text="{Binding CountOnStorage, StringFormat='На складе: {0}'}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat='{}{0:N2} руб.'}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Удалить" Click="MenuItemDelete_Click"/>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <TextBlock x:Name="txtCount" Text="0 из 0"/>
            <Button Content="Выход" Click="BtnExit_Click" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
